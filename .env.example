# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored - NEVER commit real values.
# In CI these come from GitHub Actions secrets, not from this file.
# ---------------------------------------------------------------------------

# --- Sauce Labs credentials -------------------------------------------------
# Found at: https://app.saucelabs.com/user-settings
# SAUCE_USERNAME is NOT your login email - it is the username shown on that page.
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=

# Data centre: us-west-1 | eu-central-1 | us-east-4 | apac-southeast-1
SAUCE_REGION=us-west-1

# --- Execution defaults (all overridable on the CLI) ------------------------
# Target environment: dev | qa | staging | prod
TEST_ENV=qa

# Where tests run: sauce_vdc (emulators/simulators) | sauce_rdc (real devices) | local
TEST_TARGET=sauce_vdc

# Platform: android | ios
PLATFORM=android

# Which app definition from config/apps.yaml to install
APP_KEY=demo_app

# Build label grouping jobs in the Sauce dashboard
BUILD_NAME=local-dev

# --- Local Appium (only when TEST_TARGET=local) -----------------------------
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
